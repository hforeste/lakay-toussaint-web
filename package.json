{
  "name": "lakay-toussaint-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "npm --prefix admin run dev",
    "build": "next build",
    "build:admin": "npm --prefix admin run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "npm --prefix admin run typecheck",
    "emulators": "node scripts/start-emulators.mjs",
    "validate": "npm run typecheck && npm run build",
    "validate:firebase": "node scripts/validate-firestore-emulator.mjs",
    "validate:browser:install": "playwright-cli install-browser chromium",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-postgres.mjs",
    "db:setup": "node scripts/prepare-local-env.mjs && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.15",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.3.3",
    "firebase-tools": "^14.23.0",
    "typescript": "^5.8.3"
  }
}
